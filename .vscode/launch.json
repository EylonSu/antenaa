{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Antenna Tracker",
      "type": "debugpy",
      "request": "launch",
      "module": "antenna_tracker",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Demo Turret",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/demo_turret.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal"
    }
  ]
}
